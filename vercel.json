{
  "version": 2,
  "name": "medcolleague-pwa",
  "cleanUrls": true,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/sw.js",
      "destination": "/sw.js"
    },
    {
      "source": "/manifest.json",
      "destination": "/manifest.json"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
