{
  "version": 2,
  "name": "medcolleague-pwa",
  "cleanUrls": true,
  "outputDirectory": "public",
  "routes": [
    {
      "src": "/sw.js",
      "headers": { "cache-control": "no-cache" },
      "dest": "/sw.js"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
