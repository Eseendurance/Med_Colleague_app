datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  RESIDENT
  ATTENDING
  ADMIN
}

enum Plan {
  FREE
  PRO_MONTHLY
  PRO_ANNUAL
  INSTITUTIONAL
}

enum ExamType {
  USMLE_STEP_1
  USMLE_STEP_2_CK
  USMLE_STEP_3
  NCLEX_RN
  MRCP_UK
  GENERAL_CLINICAL
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String
  role                Role                 @default(STUDENT)
  plan                Plan                 @default(FREE)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  questionAttempts    QuestionAttempt[]
  flashcardReviews    FlashcardReview[]
  tutorSessions       TutorSession[]
  organSystemMastery  OrganSystemMastery[]
  uploadedCases       UploadedCase[]
  generatedItems      GeneratedItem[]
  subscriptions       Subscription[]
  studySessions       StudySession[]
}

model Question {
  id             String            @id @default(uuid())
  examType       ExamType
  organSystem    String
  vignette       String
  options        Json              // Array of option strings
  correctIndex   Int
  explanation    String
  highYieldPearl String
  difficulty     String            @default("Medium")
  createdAt      DateTime          @default(now())
  attempts       QuestionAttempt[]

  @@index([organSystem])
}

model QuestionAttempt {
  id            String   @id @default(uuid())
  userId        String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  timeTakenSec  Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Flashcard {
  id          String            @id @default(uuid())
  organSystem String
  front       String
  back        String
  pearl       String
  reviews     FlashcardReview[]

  @@index([organSystem])
}

model FlashcardReview {
  id           String    @id @default(uuid())
  userId       String
  flashcardId  String
  easeFactor   Float     @default(2.5)
  intervalDays Int       @default(1)
  repetitions  Int       @default(0)
  nextReviewAt DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

model OrganSystemMastery {
  id                    String   @id @default(uuid())
  userId                String
  organSystem           String
  pMastery              Float    @default(0.5)
  attemptsCount         Int      @default(0)
  correctCount          Int      @default(0)
  flashcardReviewsCount Int      @default(0)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organSystem])
  @@index([userId, organSystem])
}

model UploadedCase {
  id          String   @id @default(uuid())
  userId      String
  fileName    String
  caseText    String
  summary     String
  organSystem String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedItem {
  id          String   @id @default(uuid())
  userId      String
  itemType    String   // QBank, Flashcard, ClinicalSummary
  organSystem String
  content     Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String   @id @default(uuid())
  userId               String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String   @default("active")
  plan                 Plan     @default(FREE)
  currentPeriodEnd     DateTime
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  sessionType     String   // QBank, Flashcard, Tutor, Calculator
  durationMinutes Int      @default(0)
  itemsCompleted  Int      @default(0)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TutorSession {
  id           String   @id @default(uuid())
  userId       String
  documentText String
  dialogue     Json     // Chat transcript array
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
