datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  CLINICIAN
  ADMIN
  VIEWER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum Plan {
  FREE_TRIAL
  PRO_MONTHLY
  PRO_ANNUAL
  ENTERPRISE_INSTITUTION
}

enum ExamType {
  USMLE_STEP_1
  USMLE_STEP_2_CK
  USMLE_STEP_3
  NCLEX_RN
  MRCP_UK
  GENERAL_CLINICAL
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String?
  image               String?
  role                Role                 @default(STUDENT)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  // 14-Day Free Trial Engine
  trialStartedAt      DateTime             @default(now())
  trialEndsAt         DateTime             @default(dbgenerated("NOW() + interval '14 days'"))

  // Multi-Tenant Workspace Relation
  workspaceId         String?
  workspace           Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  // Clinical Content & Study Relations
  notes               Note[]
  questionAttempts    QuestionAttempt[]
  flashcardReviews    FlashcardReview[]
  tutorSessions       TutorSession[]
  organSystemMastery  OrganSystemMastery[]
  uploadedCases       UploadedCase[]
  generatedItems      GeneratedItem[]
  usageLogs           UsageLog[]
  studySessions       StudySession[]

  @@index([workspaceId])
  @@index([email])
}

model Workspace {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Stripe Subscriptions
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?

  members              User[]
  usageLogs            UsageLog[]

  @@index([slug])
}

model Note {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String
  organSystem String   @default("General")
  tags        String[]
  isPinned    Boolean  @default(false)
  isHighYield Boolean  @default(true)
  audioUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organSystem])
  @@index([userId, isPinned])
}

model UsageLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  action      String   // e.g. "AI_QUERY", "CASE_PARSING", "QBANK_GENERATION", "TTS_SYNTHESIS"
  tokensUsed  Int      @default(0)
  timestamp   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, timestamp])
  @@index([userId, timestamp])
}

model Question {
  id             String            @id @default(cuid())
  examType       ExamType          @default(USMLE_STEP_2_CK)
  organSystem    String
  vignette       String
  options        Json              // Array of option strings
  correctIndex   Int
  explanation    String
  highYieldPearl String
  difficulty     String            @default("Medium")
  createdAt      DateTime          @default(now())
  attempts       QuestionAttempt[]

  @@index([organSystem])
}

model QuestionAttempt {
  id            String   @id @default(cuid())
  userId        String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  timeTakenSec  Int      @default(0)
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question      Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Flashcard {
  id          String            @id @default(cuid())
  organSystem String
  front       String
  back        String
  pearl       String
  reviews     FlashcardReview[]

  @@index([organSystem])
}

model FlashcardReview {
  id           String    @id @default(cuid())
  userId       String
  flashcardId  String
  easeFactor   Float     @default(2.5)
  intervalDays Int       @default(1)
  repetitions  Int       @default(0)
  nextReviewAt DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard    Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@index([userId, nextReviewAt])
}

model OrganSystemMastery {
  id                    String   @id @default(cuid())
  userId                String
  organSystem           String
  pMastery              Float    @default(0.5)
  attemptsCount         Int      @default(0)
  correctCount          Int      @default(0)
  flashcardReviewsCount Int      @default(0)
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organSystem])
  @@index([userId, organSystem])
}

model UploadedCase {
  id          String   @id @default(cuid())
  userId      String
  fileName    String
  caseText    String
  summary     String
  organSystem String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GeneratedItem {
  id          String   @id @default(cuid())
  userId      String
  itemType    String   // QBank, Flashcard, ClinicalSummary, Note
  organSystem String
  content     Json
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  sessionType     String   // QBank, Flashcard, Tutor, Calculator, Notes
  durationMinutes Int      @default(0)
  itemsCompleted  Int      @default(0)
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TutorSession {
  id           String   @id @default(cuid())
  userId       String
  documentText String
  dialogue     Json     // Chat transcript array
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
